# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# `secrets.toml` is gitignored -- never commit it.

# ---------------------------------------------------------------------------
# YouTube Data API v3
# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
# Make sure "YouTube Data API v3" is enabled for the same project.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY = "AIzaSy...replace-me"

# ---------------------------------------------------------------------------
# Google Sheet target
# SHEET_KEY is the long id in the Sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_KEY>/edit
# The worksheet (tab) is created automatically if it doesn't exist.
# ---------------------------------------------------------------------------
SHEET_KEY = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"
WORKSHEET_NAME = "comments"

# ---------------------------------------------------------------------------
# Google service account
# Google Cloud Console -> IAM & Admin -> Service Accounts -> Create -> Keys ->
# Add key -> JSON. Then copy each field from that JSON file below.
#
# IMPORTANT: after creating the service account, open your Google Sheet and
# share it with `client_email` below, giving it **Editor** access. Without that
# share the app gets a 403 no matter how correct the credentials are.
#
# For `private_key`, keep it on one line and keep the literal \n sequences
# exactly as they appear in the JSON file.
# ---------------------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "0123456789abcdef0123456789abcdef01234567"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"
client_email = "social-listening@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/social-listening%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# ---------------------------------------------------------------------------
# Anthropic (Claude) API -- powers comment translation
# console.anthropic.com -> API keys -> Create key.
# Without this the app still fetches and stores comments; only the Translate
# action on non-English comments is disabled.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY = "sk-ant-...replace-me"

